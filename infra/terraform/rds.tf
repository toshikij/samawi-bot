# Samawi Bot's own Postgres: small, private, encrypted, backed up (same shape as Seduh's).
resource "random_password" "db" {
  length  = 32
  special = false
}

resource "aws_db_subnet_group" "db" {
  name       = "samawi-bot-db"
  subnet_ids = var.db_subnet_ids
}

resource "aws_security_group" "db" {
  name        = "samawi-bot-db"
  description = "Postgres from the Samawi Bot tasks only"
  vpc_id      = var.vpc_id
  ingress {
    description     = "Postgres from Samawi Bot tasks"
    from_port       = 5432
    to_port         = 5432
    protocol        = "tcp"
    security_groups = [aws_security_group.task.id, aws_security_group.dashboard.id]
  }
}

resource "aws_db_instance" "db" {
  identifier                  = "samawi-bot"
  engine                      = "postgres"
  engine_version              = "16"
  instance_class              = "db.t4g.micro"
  allocated_storage           = 20
  max_allocated_storage       = 50
  storage_type                = "gp3"
  storage_encrypted           = true
  db_name                     = "samawi"
  username                    = "samawi"
  password                    = random_password.db.result
  db_subnet_group_name        = aws_db_subnet_group.db.name
  vpc_security_group_ids      = [aws_security_group.db.id]
  publicly_accessible         = false
  multi_az                    = false
  backup_retention_period     = 7
  backup_window               = "17:00-18:00" # 00:00–01:00 WIB, clear of the 02:00 produce
  maintenance_window          = "sun:21:00-sun:22:00"
  auto_minor_version_upgrade  = true
  allow_major_version_upgrade = false
  deletion_protection         = true
  skip_final_snapshot         = false
  final_snapshot_identifier   = "samawi-bot-final"
  copy_tags_to_snapshot       = true
}

resource "aws_secretsmanager_secret" "db" {
  name        = "samawi-bot/db"
  description = "Samawi Bot DATABASE_URL, generated by Terraform"
}

resource "aws_secretsmanager_secret_version" "db" {
  secret_id = aws_secretsmanager_secret.db.id
  secret_string = jsonencode({
    DATABASE_URL = "postgresql://samawi:${random_password.db.result}@${aws_db_instance.db.address}:5432/samawi?sslmode=verify-full&sslrootcert=/etc/ssl/certs/rds-global-bundle.pem"
  })
}
